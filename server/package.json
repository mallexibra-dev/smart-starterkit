{
  "name": "server",
  "version": "0.0.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "bun --watch run src/index.ts",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run src/db/seeders/index.ts"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.5.2",
    "@hono/zod-openapi": "^1.1.0",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.9.7",
    "postgres": "^3.4.7",
    "shared": "workspace:*",
    "winston": "^3.17.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@vitest/ui": "^2.1.8",
    "drizzle-kit": "^0.30.1",
    "supertest": "^7.0.0",
    "typescript": "~5.7.3",
    "vitest": "^2.1.8"
  }
}
